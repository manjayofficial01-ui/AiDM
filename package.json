{
  "name": "aidm",
  "version": "5.6.2",
  "description": "AiDM - AI-powered download manager with a multi-connection engine, YouTube/DASH via yt-dlp, torrent/magnet, HTTP/2, and an IDM-style Chrome extension.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win nsis",
    "test:smoke": "node test/smoke.js",
    "test:integration": "node test/integration.js",
    "test:engine-v4": "node test/engine-v4.js",
    "test:fb-dedup": "node test/fb-dedup.js",
    "test:panel-freshness": "node test/panel-freshness.js",
    "test:dead-link-guard": "node test/dead-link-guard.js",
    "test:mydaddy-title": "node test/mydaddy-title.js",
    "test:range-blocked": "node test/range-blocked.js",
    "test:embed-resolver": "node test/embed-resolver.js",
    "test:browser-engine": "node test/browser-engine.js",
    "test:capsule": "node test/capsule.js",
    "test:av-tracks": "node test/av-tracks.js",
    "test:facebook-junk": "node test/facebook-junk.js",
    "test:row-accuracy": "node test/row-accuracy.js",
    "test:facebook-panel": "node test/facebook-panel.js",
    "test:ui-layout": "node test/ui-layout.js",
    "test:scheduler": "node test/scheduler.js",
    "test:interception": "node test/interception.js",
    "test:grabber": "node test/grabber.js",
    "test:facebook-resolver": "node test/facebook-resolver.js",
    "test:twitter-resolver": "node test/twitter-resolver.js",
    "test:youtube": "node test/youtube-resolver.js",
    "test:youtube-extension": "node test/youtube-extension.js",
    "test:youtube-js-runtime": "node test/youtube-js-runtime.js",
    "test:media-probe": "node test/media-probe.js",
    "test:filehost-resolver": "node test/filehost-resolver.js",
    "test:youtube-audio": "node test/youtube-audio.js",
    "test:youtube-subtitles": "node test/youtube-subtitles.js",
    "test:youtube-progress": "node test/youtube-progress.js",
    "test:server-youtube-cdn-guard": "node test/server-youtube-cdn-guard.js",
    "verify:youtube": "node tools/verify-youtube-live.js",
    "test:engine-reliability": "node test/engine-reliability.js",
    "test:row-media": "node test/row-media.js",
    "test:ui-dimensions": "node test/ui-dimensions.js",
    "test:ui-icons": "node test/ui-icons.js",
    "test:playing-now": "node test/playing-now.js",
    "test:popup-video-scope": "node test/popup-video-scope.js",
    "test": "node test/run-all.js",
    "test:extension-dimensions": "node test/extension-dimensions.js",
    "test:yt-dlp-cookies": "node test/yt-dlp-cookies.js",
    "test:yt-dlp-output": "node test/yt-dlp-output.js",
    "test:main-boot": "node test/main-boot.js",
    "test:jev-classify": "node test/jev-classify.js",
    "test:engine-agents": "node test/engine-agents.js",
    "test:engine-proxy": "node test/engine-proxy.js",
    "test:generic-resolver": "node test/generic-resolver.js",
    "test:ai-assist": "node test/ai-assist.js",
    "test:nl-vault": "node test/nl-vault.js",
    "test:gmail-attachment": "node test/gmail-attachment.js",
    "test:response-integrity": "node test/response-integrity.js",
    "test:torrent": "node test/torrent.js",
    "test:http2-transport": "node test/http2-transport.js",
    "test:auth-wall": "node test/auth-wall.js",
    "test:auth-wall-manager": "node test/auth-wall-manager.js",
    "test:single-use-token": "node test/single-use-token.js",
    "test:ext-download-guard": "node test/ext-download-guard.js",
    "test:ext-early-takeover": "node test/ext-early-takeover.js",
    "test:engine-ramp": "node test/engine-ramp.js",
    "test:ramp-controller": "node test/ramp-controller.js",
    "test:segment-advisor": "node test/segment-advisor.js",
    "test:segments-v2": "node test/segments-v2.js",
    "test:twitter-scope": "node test/twitter-scope.js",
    "test:webhooks": "node test/webhooks.js"
  },
  "keywords": [
    "download-manager",
    "electron",
    "idm",
    "multi-thread",
    "chrome-extension"
  ],
  "author": "VibeCoder ManjayOfficial01",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "mime-types": "^2.1.35",
    "uuid": "11.1.1",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.aidm.app",
    "productName": "AiDM",
    "copyright": "Copyright (c) 2026 VibeCoder ManjayOfficial01",
    "files": [
      "main.js",
      "preload.js",
      "preload-location.js",
      "package.json",
      "src/**/*",
      "ui/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "chrome-extension/",
        "to": "chrome-extension/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AiDM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AiDM",
      "uninstallDisplayName": "AiDM Download Manager",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "overrides": {
    "ip-address": "^10.7.3"
  }
}
