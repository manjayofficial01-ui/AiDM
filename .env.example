# TokenHarbor — copy to .env or export in shell. NEVER commit a real key.
# Get a key: https://tokenharbor.ai → Dashboard → Universal Key (thk_live_…)
TOKENHARBOR_API_KEY=thk_live_YOUR_KEY_HERE
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_PRIMARY_MODEL=mimo-v2.5:free
TOKENHARBOR_FALLBACK_MODEL=deepseek-v4-flash:free
